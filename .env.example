# No key is needed with the default API_TYPE=claude_code (see README): TinyTroupe uses your Claude Code login.
# Note that these variables are not loaded automatically; set them in your environment if you need them.

# Only for API_TYPE=openai:
OPENAI_API_KEY=....

# Only for API_TYPE=azure. To use Entra ID authentication, don't set the API key.
AZURE_OPENAI_KEY=....
AZURE_OPENAI_ENDPOINT=....
